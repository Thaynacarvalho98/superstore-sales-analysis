    <dashboard name='História - Visão Geral' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='527' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='3423' id='3' type-v2='title' w='98426' x='787' y='830' />
            <zone fixed-size='116' h='12033' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='4253' />
            <zone h='82884' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='16286'>
              <flipboard active-id='5' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Este projeto analisa o desempenho de vendas, lucro, categorias, segmentos, países, cidades, descontos e custos de envio da Superstore entre 2011 e 2014. O objetivo é identificar tendências de crescimento e oportunidades de melhoria.' captured-sheet='Visão Geral' id='1' />
                  <story-point caption='As vendas cresceram continuamente entre 2011 e 2014. O lucro acompanhou esse crescimento, indicando expansão consistente do negócio.' captured-sheet='Evolução das Vendas e Lucro' id='2' />
                  <story-point caption='A categoria Technology apresentou o maior lucro do período. O segmento Consumer foi responsável pelo maior volume de vendas, tornando-se o principal público da empresa.' captured-sheet='Segmento e Categoria' id='3' />
                  <story-point caption='Os Estados Unidos lideram as vendas entre todos os países. Entre as cidades, New York City e Los Angeles se destacam em vendas, enquanto cidades como Seattle apresentam elevado lucro.' captured-sheet='Ranking de Países e Cidades' id='4' />
                  <story-point caption='Descontos elevados reduzem significativamente a lucratividade. Além disso, modalidades de entrega mais rápidas apresentam maior custo médio de envio.' captured-sheet='Análise de Custos e Descontos' id='5' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{8680EA16-CD3A-48DE-96D6-99FF5C7A9777}' />
    </dashboard>
