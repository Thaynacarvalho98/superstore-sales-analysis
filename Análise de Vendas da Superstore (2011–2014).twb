          <computed-sort column='[federated.1e9wsuv10yw24z15va0ir0ccur80].[none:City:nk]' direction='DESC' using='[federated.1e9wsuv10yw24z15va0ir0ccur80].[sum:Profit:qk]' />
          <slices>
